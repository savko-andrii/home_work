#include <iostream>
#include <deque>
#include <string>
using namespace std;

class BankQueue {
private:
    deque<string> data;

public:
    void add(const string& name) {
        data.push_back("Клієнт: " + name);
    }

    void addVip(const string& name) {
        data.push_front("VIP: " + name);
    }

    string delite() {
        if (data.empty()) return "Черга порожня";
        string first = data.front();
        data.pop_front();
        return first;
    }

    void print() {
        cout << "Черга: \n";
        for (int i = 0; i < data.size(); i++) {
            cout << data[i] << endl;
        }
        cout << endl;
    }

    bool empty() {
        return data.empty();
    }
};

int main() {
    BankQueue q;

    int n;
    cout << "\nВведіть кількість клієнтів: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        string name;
        int type;
        cout << "\nІм'я: ";
        cin >> name;
        cout << "Тип (1 = звичайний, 2 = VIP): ";
        cin >> type;

        if (type == 2) {
            q.addVip(name);
        } else {
            q.add(name);
        }
    }

    cout << "\nПоточна черга:";
    q.print();

    int k;
    cout << "\nСкільки клієнтів обслуговуємо? ";
    cin >> k;

    cout << "\nОбслуговані клієнти:";
    for (int i = 0; i < k; i++) {
        cout << q.delite() << endl;
    }

    cout << "\nЧерга після обслуговування:";
    q.print();

    return 0;
}
