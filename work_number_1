#include <stdio.h>
#include <stdlib.h>

typedef struct Node 
{
    int data;
    struct Node* next;
} Node;

Node* createList() 
{
    Node* head = NULL;
    Node* tail = NULL;

    int n, x;
    printf("Скільки елементів буде в списку? ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        printf("Введіть число: ");
        scanf("%d", &x);

        Node* p = (Node*)malloc(sizeof(Node));
        p->data = x;
        p->next = NULL;

        if (head == NULL)
        {
            head = p;
            tail = p;
        }
        else 
        {
            tail->next = p;
            tail = p;
        }
    }

    return head;
}

void insertAfter(Node* head, int key, int value) 
{
    Node* t = head;
    while (t != NULL)
    {
        if (t->data == key)
        {
            Node* p = (Node*)malloc(sizeof(Node));
            p->data = value;
            p->next = t->next;
            t->next = p;
            return;
        }
        t = t->next;
    }
    printf("Не знайшов елемент %d\n", key);
}

void insertBefore(Node** head, int key, int value)
{
    if (*head == NULL) return;

    if ((*head)->data == key) 
    {
        Node* p = (Node*)malloc(sizeof(Node));
        p->data = value;
        p->next = *head;
        *head = p;
        return;
    }

    Node* t = *head;
    while (t->next != NULL)
    {
        if (t->next->data == key)
        {
            Node* p = (Node*)malloc(sizeof(Node));
            p->data = value;
            p->next = t->next;
            t->next = p;
            return;
        }
        t = t->next;
    }
    printf("Не знайшов елемент %d\n", key);
}

void printList(Node* head)
{
    Node* t = head;
    while (t != NULL) 
    {
        printf("%d ", t->data);
        t = t->next;
    }
    printf("\n");
}

void freeList(Node* head) 
{
    Node* x;
    while (head != NULL)
    {
        x = head;
        head = head->next;
        free(x);
    }
}

int main()
{
    Node* head = createList();
    printList(head);

    insertAfter(head, 2, 100);
    printList(head);

    insertBefore(&head, 2, 10);
    printList(head);
    
    freeList(head);
    return 0;
}
