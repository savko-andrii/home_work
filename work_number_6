#include <iostream>
#include <string>
#include <cmath>
using namespace std;

struct Node {
    int key;                // ключ 
    string name;            // назва товару
    double price;
    Node* left;             // лівий син
    Node* right;            // правий син
    int height;             // висота для балансування
};

Node* newNode(int key, string name, double price) {
    Node* n = new Node();
    n->key = key;
    n->name = name;
    n->price = price;
    n->left = n->right = nullptr;
    n->height = 1;
    return n;
}

// висота вузла
int height(Node* n) {
    if (n == nullptr) return 0;
    return n->height;
}

// баланс вузла
int balance(Node* n) {
    if (n == nullptr) return 0;
    return height(n->left) - height(n->right);
}

// праве обертання
Node* rotateRight(Node* y) {
    Node* x = y->left;
    Node* T2 = x->right;

    x->right = y;
    y->left = T2;

    y->height = max(height(y->left), height(y->right)) + 1;
    x->height = max(height(x->left), height(x->right)) + 1;

    return x;
}

// ліве обертання
Node* rotateLeft(Node* x) {
    Node* y = x->right;
    Node* T2 = y->left;

    y->left = x;
    x->right = T2;

    x->height = max(height(x->left), height(x->right)) + 1;
    y->height = max(height(y->left), height(y->right)) + 1;

    return y;
}

// вставка елемента
Node* insert(Node* root, int key, string name, double price) {
    if (root == nullptr)
        return newNode(key, name, price);

    if (key < root->key)
        root->left = insert(root->left, key, name, price);
    else if (key > root->key)
        root->right = insert(root->right, key, name, price);
    else
        return root; // дублікат не вставляємо

    root->height = 1 + max(height(root->left), height(root->right));

    int b = balance(root);

    // балансування
    if (b > 1 && key < root->left->key) // left-left
        return rotateRight(root);
    if (b < -1 && key > root->right->key) // right-right
        return rotateLeft(root);
    if (b > 1 && key > root->left->key) { // left-right
        root->left = rotateLeft(root->left);
        return rotateRight(root);
    }
    if (b < -1 && key < root->right->key) { // right-left
        root->right = rotateRight(root->right);
        return rotateLeft(root);
    }

    return root;
}

// мінімальний елемент
Node* minNode(Node* node) {
    Node* cur = node;
    while (cur && cur->left != nullptr)
        cur = cur->left;
    return cur;
}

// видалення елемента
Node* deleteNode(Node* root, int key) {
    if (root == nullptr) return root;

    if (key < root->key)
        root->left = deleteNode(root->left, key);
    else if (key > root->key)
        root->right = deleteNode(root->right, key);
    else {
        if (root->left == nullptr || root->right == nullptr) {
            Node* temp = root->left ? root->left : root->right;
            if (temp == nullptr) {
                temp = root;
                root = nullptr;
            } else {
                *root = *temp;
            }
            delete temp;
        } else {
            Node* temp = minNode(root->right);
            root->key = temp->key;
            root->name = temp->name;
            root->price = temp->price;
            root->right = deleteNode(root->right, temp->key);
        }
    }

    if (root == nullptr)
        return root;

    root->height = 1 + max(height(root->left), height(root->right));
    int b = balance(root);

    if (b > 1 && balance(root->left) >= 0)
        return rotateRight(root);
    if (b > 1 && balance(root->left) < 0) {
        root->left = rotateLeft(root->left);
        return rotateRight(root);
    }
    if (b < -1 && balance(root->right) <= 0)
        return rotateLeft(root);
    if (b < -1 && balance(root->right) > 0) {
        root->right = rotateRight(root->right);
        return rotateLeft(root);
    }

    return root;
}

// пошук за ключем
bool search(Node* root, int key) {
    if (root == nullptr) return false;
    if (root->key == key) return true;
    if (key < root->key) return search(root->left, key);
    return search(root->right, key);
}

// обхід у порядку
void printInOrder(Node* root) {
    if (root != nullptr) {
        printInOrder(root->left);
        cout << root->name << " — " << root->price << endl;
        printInOrder(root->right);
    }
}

// пошук найближчої ціни
Node* findClosest(Node* root, double price, Node* closest = nullptr) {
    if (root == nullptr) return closest;
    if (closest == nullptr || fabs(root->price - price) < fabs(closest->price - price))
        closest = root;
    if (price < root->price)
        return findClosest(root->left, price, closest);
    else
        return findClosest(root->right, price, closest);
}

int main() {
    Node* root = nullptr;
    int nextKey = 1;

    // додаємо товари
    root = insert(root, nextKey++, "Молоко", 28.5);
    root = insert(root, nextKey++, "Хліб", 22.0);
    root = insert(root, nextKey++, "Сир", 150.0);
    root = insert(root, nextKey++, "Яблуко", 12.3);

    cout << "Товари у порядку зростання:\n";
    printInOrder(root);

    cout << "Пошук за ключем (2): ";
    cout << (search(root, 2) ? "Знайдено\n" : "Не знайдено\n");

    cout << "Видаляємо товар з ключем 1\n";
    root = deleteNode(root, 1);
    printInOrder(root);

    cout << "Пошук найближчої ціни до 100:\n";
    Node* near = findClosest(root, 100);
    if (near)
        cout << "Найближче: " << near->name << " — " << near->price << endl;

    return 0;
}
