#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* prev;
    Node* next;
};

Node* head = NULL;
Node* tail = NULL;

void append(int x) 
{
    Node* p = new Node;
    p->data = x;
    p->prev = NULL;
    p->next = NULL;

    if (head == NULL) 
    {
        head = p;
        tail = p;
    }
    else
    {
        tail->next = p;
        p->prev = tail;
        tail = p;
    }
}

void display() 
{
    Node* p = head;
    while (p != NULL) 
    {
        cout << p->data << " ";
        p = p->next;
    }
    cout << endl;
}

void deleteByValue(int x) 
{
    Node* p = head;
    while (p != NULL && p->data != x) {
        p = p->next;
    }

    if (p == NULL) 
    {
        cout << "Немає " << x << endl;
        return;
    }

    if (p == head)
    {
        head = head->next;
        if (head != NULL) head->prev = NULL;
    } else if (p == tail)
    {
        tail = tail->prev;
        if (tail != NULL) tail->next = NULL;
    } 
    else
    {
        p->prev->next = p->next;
        p->next->prev = p->prev;
    }

    delete p;
    cout << "Видалено " << x << endl;
}

int main() 
{
    append(1);
    append(2);
    append(3);
    append(4);

    cout << "Список:";
    display();

    deleteByValue(3);
    display();

    deleteByValue(1);
    display();

    deleteByValue(5);

    return 0;
}
