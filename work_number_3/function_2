#include <iostream>
using namespace std;

struct Node 
{
    int data;
    Node* prev;
    Node* next;
    Node(int val)
    {
        data = val;
        prev = NULL;
        next = NULL;
    }
};

Node* head = NULL;
Node* tail = NULL;

void append(int val)
{
    Node* newNode = new Node(val);
    if (head == NULL)
    {
        head = newNode;
        tail = newNode;
    }
    else
    {
        tail->next = newNode;
        newNode->prev = tail;
        tail = newNode;
    }
}

void display()
{
    Node* temp = head;
    while (temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->next;
    }
    cout << endl;
}

void deleteByValue(int val)
{
    Node* current = head;
    while (current != NULL && current->data != val)
    {
        current = current->next;
    }
    if (current == NULL)
    {
        cout << "Такого елемента нема" << endl;
        return;
    }
    if (current == head) 
    {
        head = head->next;
        if (head != NULL)
        {
            head->prev = NULL;
        }
    }
    if (current == tail)
    {
        tail = tail->prev;
        if (tail != NULL)
        {
            tail->next = NULL;
        }
    }
    if (current->prev != NULL)
    {
        current->prev->next = current->next;
    }
    if (current->next != NULL) 
    {
        current->next->prev = current->prev;
    }
    delete current;
    cout << "Елемент " << val << " видалений" << endl;
}

void insertAfter(int afterVal, int newVal)
{
    Node* current = head;
    while (current != NULL && current->data != afterVal)
    {
        current = current->next;
    }
    if (current == NULL)
    {
        cout << "Елемент " << afterVal << " не знайдено" << endl;
        return;
    }
    Node* newNode = new Node(newVal);
    newNode->next = current->next;
    newNode->prev = current;
    if (current->next != NULL)
    {
        current->next->prev = newNode;
    } 
    else
    {
        tail = newNode; 
    }
    current->next = newNode;
    cout << "Вставлено " << newVal << " після " << afterVal << endl;
}

void insertBefore(int beforeVal, int newVal)
{
    Node* current = head;
    while (current != NULL && current->data != beforeVal) 
    {
        current = current->next;
    }
    if (current == NULL)
    {
        cout << "Елемент " << beforeVal << " не знайдено" << endl;
        return;
    }
    Node* newNode = new Node(newVal);
    newNode->next = current;
    newNode->prev = current->prev;
    if (current->prev != NULL)
    {
        current->prev->next = newNode;
    } else
    {
        head = newNode; 
    }
    current->prev = newNode;
    cout << "Вставлено " << newVal << " перед " << beforeVal << endl;
}

int main() 
{
    append(1);
    append(2);
    append(3);
    append(4);

    cout << "Початковий список: ";
    display();
    insertAfter(2, 10);
    display();
    insertBefore(1, 69);
    display();
    insertBefore(5, 100);

    return 0;
}
