#include <iostream>
#include <string>
using namespace std;

class Client {
public:
    string name;
    bool isVip;

    Client(string n = "", bool vip = false)
        : name(n), isVip(vip) {}

    string toString() const {
        return (isVip ? "VIP: " : "Клієнт: ") + name;
    }
};

struct Node {
    Client value;
    Node* next;
    Node* prev;

    Node(const Client& v) : value(v), next(nullptr), prev(nullptr) {}
};

class List {
public:
    Node* head;
    Node* tail;

    List() : head(nullptr), tail(nullptr) {}

    bool empty() {
        return head == nullptr;
    }

    void push_back(const Client& v) {
        Node* n = new Node(v);
        if (empty()) {
            head = tail = n;
        } else {
            tail->next = n;
            n->prev = tail;
            tail = n;
        }
    }

    void push_front(const Client& v) {
        Node* n = new Node(v);
        if (empty()) {
            head = tail = n;
        } else {
            n->next = head;
            head->prev = n;
            head = n;
        }
    }
//видалення елементу з початку
    Client pop_front() {
        if (empty()) return Client("Черга порожня", false);

        Node* n = head;
        Client val = n->value; //знач вузла

        if (head == tail) {
            head = tail = nullptr;
        } else {
            head = head->next;
            head->prev = nullptr;
        }

        delete n;
        return val; 
    }

    void print() {
        Node* cur = head;
        while (cur != nullptr) {
            cout << cur->value.toString() << endl;
            cur = cur->next;
        }
        cout << endl;
    }
};

class BankQueue {
private:
    List data;

public:
    void add(const string& name) {
        data.push_back(Client(name, false));
    }

    void addVip(const string& name) {
        data.push_front(Client(name, true));
    }

    string delite() {
        Client c = data.pop_front();
        return c.toString();
    }

    void print() {
        cout << "Черга:\n";
        data.print();
    }

    bool empty() {
        return data.empty();
    }
};

int main() {
    BankQueue q;

    int n;
    cout << "\nВведіть кількість клієнтів: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        string name;
        int type;
        cout << "\nІм'я: ";
        cin >> name;
        cout << "Тип (1 = звичайний, 2 = VIP): ";
        cin >> type;

        if (type == 2)
            q.addVip(name);
        else
            q.add(name);
    }

    cout << "\nПоточна черга:\n";
    q.print();

    int k;
    cout << "\nСкільки клієнтів обслуговуємо? ";
    cin >> k;

    cout << "\nОбслуговані клієнти:\n";
    for (int i = 0; i < k; i++) {
        cout << q.delite() << endl;
    }

    cout << "\nЧерга після обслуговування:\n";
    q.print();

    return 0;
}
